<Project>
    <PropertyGroup>
        <Authors>EP.Tamin.NET Contributors</Authors>
        <Company>EP.Tamin.NET</Company>
        <Copyright>Copyright © EP.Tamin.NET Contributors</Copyright>
        <RepositoryUrl>https://github.com/mobinseven/EP.Tamin.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Nice to include for NuGet metadata -->
        <RepositoryType>git</RepositoryType>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <!-- Optional: default prerelease channel when not at a tag -->
        <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <!-- CI niceties: deterministic + better SourceLink paths -->
        <ContinuousIntegrationBuild Condition="'$(CI)'=='true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <PropertyGroup>
        <!-- Plug our target into NuGet’s pack pipeline -->
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);_IncludeLocalRefOutputs
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Absolute path where Pack will drop .nupkg (per configuration) -->
        <PackageOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\Pack\</PackageOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <Target Name="PushAfterPack"
			AfterTargets="Pack"
			Condition="'$(Configuration)'=='Release' and '$(BuildingInsideVisualStudio)'=='true'">
        <ItemGroup>
            <_Pkg Include="$(PackageOutputPath)*.nupkg" />
        </ItemGroup>

        <Message Text="Pushing: %(_Pkg.Identity)" Importance="High" />
        <Exec Command='dotnet nuget push "%(_Pkg.Identity)" -s https://api.nuget.org/v3/index.json --skip-duplicate' />
    </Target>

</Project>
